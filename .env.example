# 1. NEON SERVERLESS POSTGRESQL CONNECTION STRING
# Obtain this from your Neon Console (https://console.neon.tech/)
# Project Dashboard -> Connection Details -> Connection String (Pooled or Direct)
# Example format:
DATABASE_URL=postgresql://neondb_owner:npg_abcdef123456@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternate aliases automatically supported by Vercel Postgres / Neon integration:
# NEON_DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# 2. VITE DEV SERVER PORT (Optional, default 5173)
PORT=5173
